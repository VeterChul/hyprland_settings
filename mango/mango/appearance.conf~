# ==========================================
# Настройки внешнего вида (Appearance)
# ==========================================

# ----- Основные настройки -----
gaps_in = 2
gaps_out = 5
border_size = 2

# Цвета границ (можно будет поменять позже)
col.active_border = rgb(FF00FF)
col.inactive_border = rgb(4B00bb)

# ----- Прозрачность -----
# Активные и неактивные окна
active_opacity = 1.0
inactive_opacity = 1.0

# ----- Размытие -----
blur = true
blur_size = 3
blur_passes = 1
blur_vibrancy = 0.1696

# ----- Тени -----
shadow = true
shadow_range = 4
shadow_color = rgba(1a1a1aee)

# ----- Скругление углов -----
rounding = 10