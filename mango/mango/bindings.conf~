# ==========================================
# Бинды клавиш
# ==========================================

# ----- Запуск приложений -----
bind=SUPER,W,spawn,kitty sudo nmtui
bind=SUPER,Return,spawn,kitty
bind=SUPER+CTRL,Return,spawn,edex-ui
bind=SUPER+SHIFT,Return,spawn,cool-retro-term
bind=SUPER,D,spawn,rofi -show drun
bind=SUPER+CTRL,D,spawn,qs -c noctalia-shell ipc call launcher toggle
bind=SUPER+SHIFT,D,spawn,rofi -show window
bind=SUPER,B,spawn,zen-browser
bind=SUPER+SHIFT,B,spawn,yandex-browser-stable
bind=SUPER,T,spawn,ferdium
bind=SUPER+SHIFT,T,spawn,Telegram
bind=SUPER+SHIFT,C,spawn,codium
bind=SUPER,C,spawn,emacs
bind=SUPER,X,spawn,thunar
bind=SUPER,E,spawn,thunar
bind=SUPER+SHIFT,E,spawn,kitty yazi
bind=SUPER+CTRL,E,spawn,dolphin
bind=SUPER,P,spawn,qs -c noctalia-shell ipc call controlCenter toggle
bind=SUPER,O,spawn,qs -c noctalia-shell ipc call calendar toggle
bind=SUPER,I,spawn,qs -c noctalia-shell ipc call notifications toggleHistory

# ----- Скриншоты (для клавиш без модификатора используем NONE) -----
bind=NONE,Print,spawn,flameshot gui
bind=SUPER,Print,spawn,flameshot full -c

# ----- Управление окнами -----
bind=SUPER,Q,killclient
bind=SUPER,F,togglefullscreen
bind=SUPER,V,togglefloating

# ----- Перемещение фокуса -----
bind=SUPER,Left,focusdir,left
bind=SUPER,Right,focusdir,right
bind=SUPER,Up,focusdir,up
bind=SUPER,Down,focusdir,down
bind=SUPER,H,focusdir,left
bind=SUPER,L,focusdir,right
bind=SUPER,K,focusdir,up
bind=SUPER,J,focusdir,down

# ----- Изменение размера -----
bind=SUPER+CTRL,Left,resizewin,-20,0
bind=SUPER+CTRL,Right,resizewin,20,0
bind=SUPER+CTRL,Up,resizewin,0,-20
bind=SUPER+CTRL,Down,resizewin,0,20
bind=SUPER+CTRL,H,resizewin,-20,0
bind=SUPER+CTRL,L,resizewin,20,0
bind=SUPER+CTRL,K,resizewin,0,-20
bind=SUPER+CTRL,J,resizewin,0,20

# ----- Обмен окон -----
bind=SUPER+SHIFT,Left,exchange_client,left
bind=SUPER+SHIFT,Right,exchange_client,right
bind=SUPER+SHIFT,Up,exchange_client,up
bind=SUPER+SHIFT,Down,exchange_client,down
bind=SUPER+SHIFT,H,exchange_client,left
bind=SUPER+SHIFT,L,exchange_client,right
bind=SUPER+SHIFT,K,exchange_client,up
bind=SUPER+SHIFT,J,exchange_client,down

# ----- Переключение тегов (следующий/предыдущий) -----
bind=SUPER+SHIFT+CTRL,Right,viewtoright,0
bind=SUPER+SHIFT+CTRL,Left,viewtoleft,0
bind=SUPER+SHIFT+CTRL,Up,view,10
bind=SUPER+SHIFT+CTRL,Down,view,2
bind=SUPER+SHIFT+CTRL,L,viewtoright,0
bind=SUPER+SHIFT+CTRL,H,viewtoleft,0
bind=SUPER+SHIFT+CTRL,K,view,10
bind=SUPER+SHIFT+CTRL,J,view,2

# ----- Переключение на конкретный тег -----
bind=SUPER,1,view,1
bind=SUPER,2,view,2
bind=SUPER,3,view,3
bind=SUPER,4,view,4
bind=SUPER,5,view,5
bind=SUPER,6,view,6
bind=SUPER,7,view,7
bind=SUPER,8,view,8
bind=SUPER,9,view,9
bind=SUPER,0,view,10

# ----- Перемещение окна на тег -----
bind=SUPER+SHIFT,1,tag,1
bind=SUPER+SHIFT,2,tag,2
bind=SUPER+SHIFT,3,tag,3
bind=SUPER+SHIFT,4,tag,4
bind=SUPER+SHIFT,5,tag,5
bind=SUPER+SHIFT,6,tag,6
bind=SUPER+SHIFT,7,tag,7
bind=SUPER+SHIFT,8,tag,8
bind=SUPER+SHIFT,9,tag,9
bind=SUPER+SHIFT,0,tag,10

# ----- Перемещение мышью -----
mousebind=SUPER,btn_left,moveresize,curmove
mousebind=SUPER,btn_right,moveresize,curresize

# ----- Выход -----
bind=SUPER+SHIFT,M,quit

# ----- Мультимедиа (используем NONE вместо пустого поля) -----
bind=NONE,XF86AudioRaiseVolume,spawn,wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bind=NONE,XF86AudioLowerVolume,spawn,wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bind=NONE,XF86AudioMute,spawn,wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bind=NONE,XF86AudioMicMute,spawn,wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bind=NONE,XF86MonBrightnessUp,spawn,brightnessctl -e4 -n2 set 5%+
bind=NONE,XF86MonBrightnessDown,spawn,brightnessctl -e4 -n2 set 5%-
bind=NONE,XF86AudioNext,spawn,playerctl next
bind=NONE,XF86AudioPause,spawn,playerctl play-pause
bind=NONE,XF86AudioPlay,spawn,playerctl play-pause
bind=NONE,XF86AudioPrev,spawn,playerctl previous

# ----- Жесты тачпада -----
gesturebind=none,right,3,viewtoleft,0
gesturebind=none,left,3,viewtoright,0

bind=SUPER,R,reload_config

xkb_rules_layout=us,ru