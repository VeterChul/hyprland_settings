# Правила для окон (Window Rules)
# ==========================================

# Примеры правил из вашего Hyprland конфига
windowrule = opacity 0.95, class:codium
windowrule = opacity 0.95, class:obsidian

# Делаем некоторые окна плавающими (например, диалоги)
windowrule = float, class:firefox, title:.*(Open|Save).*
windowrule = float, class:zen-browser, title:.*(Open|Save).*
windowrule = float, class:Thunar, title:.*(Open|Save).*