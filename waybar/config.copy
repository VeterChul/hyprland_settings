{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 5,
    "margin-top": 5,
    "margin-left": 5,
    "margin-right": 5,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["network", "disk", "pulseaudio", "hyprland/language", "clock"],
    
    "hyprland/workspaces": {
        "format": "{name}",
        "format-icons": {
            "active": " {name} ",
            "default": " {name} ",
            "urgent": " {name} "
        },
        "on-click": "activate",
        "all-outputs": false
    },
    
    "network": {
        "format": "ᯤ {ifname}",
        "format-ethernet": "ᯤ {ipaddr}",
        "format-disconnected": "⚠",
        "max-length": 50
    },
    
    "disk": {
        "interval": 30,
        "format": "🖴 {free}",
        "path": "/"
    },
    
    "pulseaudio": {
        "format": " {icon} {volume}%",
        "format-muted": "Нет звука",
        "format-icons": {
            "default": ["Звук"]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    
    "clock": {
        "interval": 1,
        "format": "{:%d-%m-%Y | %H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "hyprland/language": {
      "format-en": "En",
      "format-ru": "Ru"
    }
}
